---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <ul class="icons">
      <li>
        <button type="button" class="icon-button theme-toggle" id="theme-toggle" aria-label="Toggle dark and light mode" title="Toggle dark/light mode">
          <Icon name="moon" class="icon-moon" />
          <Icon name="sun" class="icon-sun" />
        </button>
      </li>
      <li>
        <a class="icon-button" href="/publication/" aria-label="Publications" title="Publications"><Icon name="book" /></a>
      </li>
      <li>
        <a class="icon-button" href="/news/" aria-label="News" title="News"><Icon name="news" /></a>
      </li>
      <li>
        <a class="icon-button" href={`mailto:${profile.emails[0]}`} aria-label="Email" title="Email"><Icon name="email" /></a>
      </li>
    </ul>
    <p class="copyright">© {year} {profile.name}</p>
  </div>
</footer>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  });
</script>
