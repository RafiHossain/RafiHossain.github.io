---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-rule">
  <div class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-6 text-sm text-faint md:flex-row md:justify-between md:px-6">
    <p>© {year} {profile.name}</p>
    <p>
      <a class="link-quiet" href={`mailto:${profile.emails[0]}`}>{profile.emails[0]}</a>
    </p>
  </div>
</footer>
