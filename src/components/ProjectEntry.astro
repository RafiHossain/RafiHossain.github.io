---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Compact variant for the home page: summary, tools and links only. */
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { data } = project;
const related = data.relatedPublication ? await getEntry('publications', data.relatedPublication) : undefined;
const { Content } = await render(project);
---

<article class="border-l-2 border-navy/25 pl-4" id={project.id}>
  <h3 class="text-lg font-semibold">{data.title}</h3>
  <p class="mt-1 text-[0.97rem]">{data.summary}</p>

  {!compact && (
    <dl class="mt-3 space-y-2 text-[0.95rem]">
      {data.problem && (
        <div>
          <dt class="font-semibold text-ink">Research problem</dt>
          <dd class="text-muted">{data.problem}</dd>
        </div>
      )}
      {data.methods.length > 0 && (
        <div>
          <dt class="font-semibold text-ink">Methods</dt>
          <dd>
            <ul class="list-disc pl-5 text-muted marker:text-faint">
              {data.methods.map((m) => <li>{m}</li>)}
            </ul>
          </dd>
        </div>
      )}
      {data.output && (
        <div>
          <dt class="font-semibold text-ink">Key result</dt>
          <dd class="text-muted">{data.output}</dd>
        </div>
      )}
    </dl>
  )}
  {!compact && <div class="mt-2 text-[0.95rem] text-muted"><Content /></div>}

  {data.tools.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tools and technologies">
      {data.tools.map((t) => <li class="tag">{t}</li>)}
    </ul>
  )}

  {(data.repo || related) && (
    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {data.repo && (
        <a href={data.repo} class="inline-flex items-center gap-1.5">
          <Icon name="github" class="h-4 w-4" />
          Code repository
        </a>
      )}
      {related && related.data.doi && (
        <a href={`https://doi.org/${related.data.doi}`} class="inline-flex items-center gap-1.5">
          <Icon name="external" class="h-3.5 w-3.5" />
          Related paper: <em>{related.data.venue}</em> ({related.data.year})
        </a>
      )}
    </p>
  )}
</article>
