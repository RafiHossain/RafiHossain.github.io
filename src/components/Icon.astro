---
// Dependency-free icon set (brand marks adapted from Simple Icons / Octicons, CC0/MIT).
// Icons are decorative: always pair them with visible text or an aria-label on the parent.
import type { IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
const filled = ['scholar', 'researchgate', 'orcid', 'github', 'linkedin'].includes(name);
const viewBox = name === 'github' ? '0 0 16 16' : '0 0 24 24';
---

<svg
  class:list={['icon', cls]}
  viewBox={viewBox}
  aria-hidden="true"
  focusable="false"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'scholar' && <path d="M5.24 13.77 0 9.5 12 0l12 9.5-5.24 4.27C17.55 11.25 14.98 9.5 12 9.5s-5.55 1.75-6.76 4.27ZM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z" />}
  {name === 'researchgate' && (
    <>
      <rect x="1" y="1" width="22" height="22" rx="3" />
      <text x="5" y="17" font-size="11" font-family="Georgia, serif" font-weight="700" fill="var(--color-bg)">R</text>
      <text x="13" y="11" font-size="8" font-family="Georgia, serif" font-weight="700" fill="var(--color-bg)">G</text>
    </>
  )}
  {name === 'orcid' && (
    <>
      <circle cx="12" cy="12" r="11.5" />
      <text x="12" y="16.3" text-anchor="middle" font-size="11.5" font-family="Arial, sans-serif" font-weight="700" fill="var(--color-bg)">iD</text>
    </>
  )}
  {name === 'github' && <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />}
  {name === 'linkedin' && <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />}
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === 'location' && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'radar' && (<><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><path d="M12 12 18.4 5.6" /><circle cx="12" cy="12" r="1" fill="currentColor" /></>)}
  {name === 'calendar' && (<><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></>)}
  {name === 'sun' && (<><circle cx="12" cy="12" r="4" /><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8" /></>)}
  {name === 'moon' && <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />}
  {name === 'book' && (<><path d="M2.5 5.5c3-1.3 6.3-1.3 9.5.8v13.2c-3.2-2.1-6.5-2.1-9.5-.8Z" /><path d="M21.5 5.5c-3-1.3-6.3-1.3-9.5.8v13.2c3.2-2.1 6.5-2.1 9.5-.8Z" /></>)}
  {name === 'news' && (<><path d="M4 5h13v14H6a2 2 0 0 1-2-2Z" /><path d="M17 9h3v8a2 2 0 0 1-2 2h-1M7.5 8.5h6M7.5 12h6M7.5 15.5h4" /></>)}
  {name === 'flask' && (<><path d="M9 3h6M10 3v6L4.6 18.3A1.8 1.8 0 0 0 6.2 21h11.6a1.8 1.8 0 0 0 1.6-2.7L14 9V3" /><path d="M7.2 14h9.6" /></>)}
  {name === 'briefcase' && (<><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12.5h18" /></>)}
  {name === 'contact' && (<><rect x="3" y="3" width="18" height="18" rx="2.5" /><circle cx="12" cy="10" r="3" /><path d="M6.8 18c1-2.3 2.9-3.5 5.2-3.5s4.2 1.2 5.2 3.5" /></>)}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'cv' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></>)}
</svg>
