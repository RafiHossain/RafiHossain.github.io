---
// Small, dependency-free icon set. Decorative: always pair with visible or sr-only text.
interface Props {
  name: 'email' | 'scholar' | 'researchgate' | 'linkedin' | 'github' | 'orcid' | 'cv' | 'location' | 'external';
  class?: string;
}
const { name, class: cls = 'h-4 w-4' } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === 'scholar' && (<><path d="M2 9.5 12 4l10 5.5-10 5.5Z" /><path d="M6 12v4.5c1.7 1.6 3.7 2.5 6 2.5s4.3-.9 6-2.5V12" /></>)}
  {name === 'researchgate' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><text x="12" y="16" text-anchor="middle" font-size="9" font-family="Arial, sans-serif" font-weight="700" fill="currentColor" stroke="none">RG</text></>)}
  {name === 'orcid' && (<><circle cx="12" cy="12" r="9" /><text x="12" y="15.5" text-anchor="middle" font-size="9" font-family="Arial, sans-serif" font-weight="700" fill="currentColor" stroke="none">iD</text></>)}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.5v.01M11.5 17v-6.5M11.5 13c0-1.6 1-2.6 2.4-2.6S16 11.4 16 13v4" /></>)}
  {name === 'github' && (<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />)}
  {name === 'cv' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></>)}
  {name === 'location' && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'external' && (<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />)}
</svg>
