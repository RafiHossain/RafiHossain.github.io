---
// News items. `grouped` renders year headings (News page); otherwise a plain list (home page).
import Icon from './Icon.astro';
import { getNews, inlineMarkdown, newsDate } from '../lib/content';

interface Props {
  limit?: number;
  grouped?: boolean;
}
const { limit, grouped = false } = Astro.props;
const all = await getNews();
const items = limit ? all.slice(0, limit) : all;
const years = [...new Set(items.map((n) => n.data.date.getUTCFullYear()))];
---

{grouped ? (
  years.map((y) => (
    <section aria-label={String(y)}>
      <p class="news-year"><Icon name="calendar" /> <b>{y}</b></p>
      {items
        .filter((n) => n.data.date.getUTCFullYear() === y)
        .map((n) => (
          <p class="condensed">
            {newsDate(n.data.date)}: <span set:html={inlineMarkdown(n.data.text)} />
          </p>
        ))}
    </section>
  ))
) : (
  <ul>
    {items.map((n) => (
      <li>
        {newsDate(n.data.date)}: <span set:html={inlineMarkdown(n.data.text)} />
      </li>
    ))}
  </ul>
)}
