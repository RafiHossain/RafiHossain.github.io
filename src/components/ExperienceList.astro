---
// Experience grouped by organization: an italic organization heading, then each role with its dates.
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'experience'>[];
  showSummary?: boolean;
}
const { items, showSummary = true } = Astro.props;

const groups: { org: string; roles: CollectionEntry<'experience'>[] }[] = [];
for (const x of items) {
  const g = groups.find((g) => g.org === x.data.organization);
  if (g) g.roles.push(x);
  else groups.push({ org: x.data.organization, roles: [x] });
}
---

{groups.map((g) => (
  <div class="cell">
    <h3 class="org-title">{g.org}</h3>
    {g.roles.map((x) => (
      <div class="item-row">
        <div>
          <p class="condensed"><strong>{x.data.role}</strong></p>
          {showSummary && x.data.summary && <p class="condensed muted">{x.data.summary}</p>}
        </div>
        <div>
          {x.data.period && <p class="dates">{x.data.period}</p>}
        </div>
      </div>
    ))}
  </div>
))}
