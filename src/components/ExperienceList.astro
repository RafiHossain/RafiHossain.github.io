---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'experience'>[];
  showSummary?: boolean;
}
const { items, showSummary = true } = Astro.props;
---

<ul class="space-y-5">
  {items.map((x) => (
    <li>
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <h3 class="text-base font-semibold">{x.data.role}</h3>
        {x.data.period && <span class="shrink-0 text-sm tabular-nums text-faint">{x.data.period}</span>}
      </div>
      <p class="text-muted">{x.data.organization}</p>
      {showSummary && x.data.summary && <p class="mt-1 text-[0.95rem]">{x.data.summary}</p>}
    </li>
  ))}
</ul>
