---
import { getCollection } from 'astro:content';

interface Props {
  /** Show the detail lines (thesis, CGPA, courses). */
  details?: boolean;
}
const { details = true } = Astro.props;
const items = await getCollection('education');
---

{items.map((e) => (
  <div class="cell item-row wide">
    <div>
      <p class="condensed"><strong>{e.data.degree}</strong></p>
      <p class="condensed"><em>{e.data.institution}{e.data.location && `, ${e.data.location}`}</em></p>
      {details && e.data.details.map((d) => <p class="condensed muted">{d}</p>)}
    </div>
    <div>
      <p class="dates">{e.data.period}</p>
    </div>
  </div>
))}
