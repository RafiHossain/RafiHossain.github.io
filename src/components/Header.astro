---
import Icon from './Icon.astro';
import type { IconName } from './icons';
import Logo from './Logo.astro';
import { profile } from '../data/profile';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/news/', label: 'News' },
  { href: '/publication/', label: 'Publication' },
  { href: '/rnd/', label: 'R&D' },
  { href: '/experience/', label: 'Experience' },
  { href: '/contact/', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));

const links: { href: string; label: string; icon: IconName }[] = [
  { href: profile.links.googleScholar, label: 'Google Scholar', icon: 'scholar' },
  { href: profile.links.researchGate, label: 'ResearchGate', icon: 'researchgate' },
  { href: profile.links.orcid, label: 'ORCID', icon: 'orcid' },
  { href: profile.links.github, label: 'GitHub', icon: 'github' },
  { href: profile.links.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: `mailto:${profile.emails[0]}`, label: 'Email', icon: 'email' },
];
---

<header class="site-header" id="site-header">
  <div class="container">
    <div class="header-row">
      <div class="header-left">
        <p class="brand">
          <a href="/" class="brand-logo" aria-label={`${profile.name}, home`}><Logo /></a>
          <span aria-hidden="true">|</span>
          <span>Keywords:</span>
          <span class="typed" id="typed" data-words={JSON.stringify(profile.keywords)}>{profile.keywords[0]}</span><span class="typed-cursor" aria-hidden="true">_</span>
        </p>
      </div>
      <div class="header-right">
        <ul class="icons">
          {links.filter((l) => l.href).map((l) => (
            <li>
              <a class="icon-button" href={l.href} title={l.label} aria-label={l.label} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                <Icon name={l.icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <nav aria-label="Main">
      <ul class="menu">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Header shadow once the page scrolls.
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Typewriter effect over the keyword list (static when reduced motion is requested).
  const el = document.getElementById('typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0;
    let i = 0;
    let deleting = false;
    const tick = () => {
      const word = words[w] ?? '';
      i += deleting ? -1 : 1;
      el.textContent = word.slice(0, i);
      let delay = deleting ? 40 : 90;
      if (!deleting && i === word.length) {
        deleting = true;
        delay = 1600;
      } else if (deleting && i === 0) {
        deleting = false;
        w = (w + 1) % words.length;
        delay = 400;
      }
      window.setTimeout(tick, delay);
    };
    if (words.length) {
      el.textContent = '';
      window.setTimeout(tick, 600);
    }
  }
</script>
