---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import NewsList from '../components/NewsList.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile, researchInterests } from '../data/profile';
import { getProjects, getPublications } from '../lib/content';

const pubs = await getPublications();
const selected = pubs.filter((p) => p.data.selected);
const publishedCount = pubs.filter((p) => p.data.status === 'published' && p.data.type === 'journal').length;
const submittedCount = pubs.filter((p) => ['submitted', 'under-review'].includes(p.data.status)).length;
const featured = (await getProjects()).filter((p) => p.data.featured);
const experience = (await getCollection('experience')).filter((x) => x.data.category === 'research' || x.data.category === 'professional').slice(0, 3);
---

<BaseLayout>
  <div class="grid gap-10 md:grid-cols-[200px_1fr] md:gap-14">
    <aside class="md:sticky md:top-24 md:self-start" aria-label="Profile">
      <ProfileCard />
    </aside>

    <div class="min-w-0 space-y-12">
      <section aria-labelledby="about">
        <h1 id="about" class="sr-only">About {profile.name}</h1>
        <ul class="mb-5 flex flex-wrap gap-x-2 gap-y-1 text-sm text-navy" aria-label="Research keywords">
          {profile.keywords.map((k, i) => (
            <li>
              {k}
              {i < profile.keywords.length - 1 && <span class="ml-2 text-faint" aria-hidden="true">·</span>}
            </li>
          ))}
        </ul>
        <h2 class="section-title">About Me</h2>
        <div class="prose-academic text-[1.02rem]">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section aria-labelledby="interests">
        <h2 id="interests" class="section-title">Research Interests</h2>
        <ul class="grid gap-x-8 gap-y-1 sm:grid-cols-2 list-disc pl-5 marker:text-navy/50">
          {researchInterests.map((r) => <li>{r}</li>)}
        </ul>
        <p class="mt-3 text-sm"><a href="/research/">Research themes and thesis →</a></p>
      </section>

      <section aria-labelledby="news">
        <h2 id="news" class="section-title">Research Updates</h2>
        <NewsList limit={6} />
      </section>

      <section aria-labelledby="pubs">
        <h2 id="pubs" class="section-title">Selected Publications</h2>
        <p class="-mt-2 mb-4 text-sm text-muted">
          {publishedCount} peer-reviewed journal articles · {submittedCount} manuscripts submitted. Full list on the
          <a href="/publications/">publications page</a> and <a href={profile.links.googleScholar}>Google Scholar</a>.
        </p>
        <ol class="space-y-4">
          {selected.map((p) => <PublicationItem pub={p} />)}
        </ol>
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects" class="section-title">Selected Research Projects</h2>
        <div class="space-y-6">
          {featured.map((p) => <ProjectEntry project={p} compact />)}
        </div>
        <p class="mt-4 text-sm"><a href="/projects/">All projects →</a></p>
      </section>

      <section aria-labelledby="education">
        <h2 id="education" class="section-title">Education</h2>
        <EducationList limit={1} />
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience" class="section-title">Experience</h2>
        <ExperienceList items={experience} showSummary={false} />
        <p class="mt-4 text-sm"><a href="/experience/">Experience, training and leadership →</a></p>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact" class="section-title">Contact</h2>
        <p class="mb-3">
          I welcome enquiries about graduate research positions and collaboration. The best way to reach me is by email at
          <a href={`mailto:${profile.emails[0]}`}>{profile.emails[0]}</a>.
        </p>
        <ContactLinks layout="inline" />
      </section>
    </div>
  </div>
</BaseLayout>
