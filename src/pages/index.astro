---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Citation from '../components/Citation.astro';
import NewsList from '../components/NewsList.astro';
import ResearchItem from '../components/ResearchItem.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { profile } from '../data/profile';
import { ongoing } from '../data/research';
import { getProjects, getPublications, inlineMarkdown } from '../lib/content';

// Drop profile.jpg / .png / .webp into src/assets/ to use it as the portrait.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/profile.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;

const pubs = await getPublications();
const selected = pubs.filter((p) => p.data.selected);
const codeProjects = (await getProjects()).filter((p) => p.data.featured && p.data.repo);
const experience = (await getCollection('experience')).filter((x) => x.data.category === 'research' || x.data.category === 'professional');
const pubById = new Map(pubs.map((p) => [p.id, p]));
---

<BaseLayout>
  <h1 class="sr-only">{profile.name}</h1>

  <div class="intro">
    <div class="profile">
      <div class="profile-img">
        {photo ? (
          <Image src={photo} alt={`Portrait of ${profile.name}`} widths={[200, 400]} sizes="200px" loading="eager" />
        ) : (
          <span class="profile-initials" aria-hidden="true">AHR</span>
        )}
      </div>
      <p class="name">{profile.name}</p>
      {profile.sidebar.map((line) => <p set:html={inlineMarkdown(line)} />)}
      <p><Icon name="location" /> <a href={profile.locationLink}>{profile.location}</a></p>
      <p><Icon name="email" /> <a href={`mailto:${profile.emails[0]}`}>Contact Me</a></p>
    </div>

    <div>
      {profile.bioIntro.map((p) => <p class="condensed" set:html={inlineMarkdown(p)} />)}
      <ul>
        {profile.researchAreas.map((a) => <li>{a}</li>)}
      </ul>
      {profile.bioOutro.map((p) => <p class="condensed" set:html={inlineMarkdown(p)} />)}
    </div>
  </div>

  <section class="section" aria-labelledby="news">
    <p class="condensed news-head" id="news"><Icon name="radar" class="spin" /> <a href="/news/">News</a>:</p>
    <NewsList limit={5} />
  </section>

  <section class="section" aria-labelledby="selected-publication">
    <h2 class="section-title" id="selected-publication">Selected Publication</h2>
    <p class="note">
      * Here is a list of my recent peer-reviewed publications. Please see the <a href="/publication/">Publication Page</a> for submitted work and conference papers.<br />
      * Full publication list and citations can be found on my <a href={profile.links.googleScholar}>Google Scholar Profile</a>.
    </p>
    {selected.map((p) => <div class="cell"><Citation pub={p} /></div>)}
  </section>

  <section class="section" aria-labelledby="research">
    <h2 class="section-title" id="research">Research</h2>
    <p class="note">* Here is a list of my current and recent research. Please see the <a href="/rnd/">R&amp;D Page</a> for all research and development projects.</p>
    {ongoing.map((r) => <ResearchItem {...r} />)}
    {codeProjects.map((p) => {
      const rel = p.data.relatedPublication ? pubById.get(p.data.relatedPublication) : undefined;
      return (
        <ResearchItem title={p.data.title} role="Open-source code" period={rel?.data.year ? `Paper published ${rel.data.year}` : undefined}>
          <p class="condensed">{p.data.summary} <a href={p.data.repo}>GitHub repository</a>{rel?.data.doi && <>, <a href={`https://doi.org/${rel.data.doi}`}>paper</a></>}.</p>
        </ResearchItem>
      );
    })}
  </section>

  <section class="section" aria-labelledby="education">
    <h2 class="section-title" id="education">Education</h2>
    <EducationList details={false} />
  </section>

  <section class="section" aria-labelledby="experience">
    <h2 class="section-title" id="experience">Professional Experience</h2>
    <ExperienceList items={experience} showSummary={false} />
  </section>
</BaseLayout>
