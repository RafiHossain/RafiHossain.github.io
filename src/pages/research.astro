---
import PageLayout from '../layouts/PageLayout.astro';
import { researchInterests, skills } from '../data/profile';
import { collaborators, themes } from '../data/research';
import { getPublications } from '../lib/content';

const pubs = await getPublications();
const byId = new Map(pubs.map((p) => [p.id, p]));
---

<PageLayout
  title="Research"
  description="Research themes of Al Hossain Rafi: InSAR land subsidence, climate hazard susceptibility, urban growth, water resources and geospatial machine learning."
  lead="I use remote sensing, GIS and machine learning to study environmental hazards and urban change in Bangladesh, with a focus on land subsidence in deltaic cities."
>
  <section aria-labelledby="thesis">
    <h2 id="thesis" class="section-title">Undergraduate Thesis</h2>
    <p class="font-serif text-lg leading-snug">
      Optimized geohazard monitoring: A DInSAR, InSAR, and explainable machine learning approach for land subsidence quantification in the deltaic metropolis of Bangladesh
    </p>
    <p class="mt-1 text-sm text-muted">B.URP thesis, Department of Urban and Regional Planning, KUET</p>
    <p class="mt-3 font-semibold">Aims</p>
    <ol class="list-[lower-roman] pl-6 text-muted">
      <li>to examine how different factors affect land subsidence in Khulna City Corporation (KCC);</li>
      <li>to identify areas highly susceptible to land subsidence in KCC using a data-driven method;</li>
      <li>to evaluate data-driven algorithms for forecasting land subsidence risk in KCC.</li>
    </ol>
  </section>

  <section aria-labelledby="themes">
    <h2 id="themes" class="section-title">Research Themes</h2>
    <div class="space-y-8">
      {themes.map((t) => {
        const related = t.publications.map((id) => byId.get(id)).filter((p) => p !== undefined);
        return (
          <div>
            <h3 class="text-lg font-semibold">{t.title}</h3>
            <p class="mt-1">{t.text}</p>
            {related.length > 0 && (
              <ul class="mt-2 space-y-1 border-l-2 border-rule pl-4 text-[0.93rem] text-muted">
                {related.map((p) => (
                  <li>
                    {p.data.doi ? <a href={`https://doi.org/${p.data.doi}`}>{p.data.title}</a> : <span>{p.data.title}</span>}
                    <span class="text-faint">
                      {' '}— {p.data.status === 'published' ? <em>{p.data.venue}</em> : p.data.status === 'accepted' ? <><em>{p.data.venue}</em> (accepted)</> : p.data.status === 'in-preparation' ? 'in preparation' : 'submitted'}
                      {p.data.year && `, ${p.data.year}`}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <section aria-labelledby="interests">
    <h2 id="interests" class="section-title">Research Interests</h2>
    <ul class="grid list-disc gap-x-8 gap-y-1 pl-5 marker:text-navy/50 sm:grid-cols-2">
      {researchInterests.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <section aria-labelledby="methods">
    <h2 id="methods" class="section-title">Methods and Tools</h2>
    <dl class="space-y-3">
      {skills.map((s) => (
        <div class="sm:grid sm:grid-cols-[11rem_1fr] sm:gap-4">
          <dt class="font-semibold">{s.group}</dt>
          <dd class="text-muted">{s.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="collab">
    <h2 id="collab" class="section-title">Collaborators</h2>
    <ul class="space-y-2">
      {collaborators.map((c) => (
        <li>
          <span class="font-semibold">{c.name}</span>
          <span class="text-muted"> — {c.role}</span>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
