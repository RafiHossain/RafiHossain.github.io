---
import PageLayout from '../layouts/PageLayout.astro';
import EducationList from '../components/EducationList.astro';
import { profile } from '../data/profile';
import { cvAvailable, getPublications } from '../lib/content';

const hasCv = cvAvailable();
const pubs = await getPublications();
const journal = pubs.filter((p) => p.data.type === 'journal' && p.data.status === 'published').length;
const accepted = pubs.filter((p) => p.data.status === 'accepted').length;
const conference =pubs.filter((p) => p.data.type === 'conference' && p.data.status === 'published').length;
---

<PageLayout title="Curriculum Vitae" description="Curriculum vitae of Al Hossain Rafi.">
  <section aria-labelledby="download">
    <h2 id="download" class="section-title">Download</h2>
    {hasCv ? (
      <p>
        <a href={profile.cvFile} class="inline-flex items-center rounded border border-navy px-4 py-2 font-semibold no-underline hover:bg-navy hover:text-white">
          Download CV (PDF)
        </a>
      </p>
    ) : (
      <p class="rounded border border-dashed border-rule bg-tint px-4 py-3 text-muted">
        A PDF version of my CV will be available here soon. In the meantime, please
        <a href={`mailto:${profile.emails[0]}`}>email me</a> for a copy.
      </p>
    )}
  </section>

  <section aria-labelledby="summary">
    <h2 id="summary" class="section-title">At a Glance</h2>
    <ul class="list-disc space-y-1 pl-5 marker:text-navy/50">
      <li>B.URP, Khulna University of Engineering & Technology (2020 – 2025), CGPA 3.35 / 4.00</li>
      <li>{journal} peer-reviewed journal articles{accepted > 0 && `, ${accepted} accepted`} and {conference} conference papers — <a href="/publications/">publications</a></li>
      <li>Research Associate, PLANCON (2026 – present); Research Assistant, Center for Environmental Research (2023 – 2025) — <a href="/experience/">experience</a></li>
      <li>GIS intern, Khulna City Corporation (2024)</li>
      <li>Research code on <a href={profile.links.github}>GitHub</a> — <a href="/projects/">projects</a></li>
    </ul>
  </section>

  <section aria-labelledby="education">
    <h2 id="education" class="section-title">Education</h2>
    <EducationList />
  </section>
</PageLayout>
