---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { profile } from '../data/profile';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const research = projects.filter((p) => p.data.category === 'research');
const academic = projects.filter((p) => p.data.category === 'academic');
---

<PageLayout
  title="Projects"
  description="Research code and academic planning projects by Al Hossain Rafi: forest fire and urban expansion susceptibility modeling, transportation, rural and environmental studies."
  lead="Research projects with public code, followed by field and planning studies completed during my B.URP at KUET."
>
  <section aria-labelledby="research-projects">
    <h2 id="research-projects" class="section-title">Research Projects with Code</h2>
    <div class="space-y-10">
      {research.map((p) => <ProjectEntry project={p} />)}
    </div>
    <p class="mt-6 text-sm text-muted">More code is available on <a href={profile.links.github}>GitHub</a>.</p>
  </section>

  <section aria-labelledby="academic-projects">
    <h2 id="academic-projects" class="section-title">Academic and Field Projects</h2>
    <div class="space-y-10">
      {academic.map((p) => <ProjectEntry project={p} />)}
    </div>
  </section>
</PageLayout>
