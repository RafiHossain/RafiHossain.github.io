---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import { profile } from '../data/profile';
import { cvAvailable } from '../lib/content';

type ProfileLink = { href: string; label: string; icon: IconName };
const profiles: ProfileLink[] = ([
  { href: profile.links.googleScholar, label: 'Google Scholar', icon: 'scholar' },
  { href: profile.links.researchGate, label: 'ResearchGate', icon: 'researchgate' },
  { href: profile.links.orcid, label: 'ORCID', icon: 'orcid' },
  { href: profile.links.github, label: 'GitHub', icon: 'github' },
  { href: profile.links.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: cvAvailable() ? profile.cvFile : '', label: 'CV (PDF)', icon: 'cv' },
] satisfies ProfileLink[]).filter((p) => p.href);
---

<PageLayout title="Contact" icon="contact" description="Contact Al Hossain Rafi about research and collaboration.">
  <p class="condensed" style="text-align:center">
    I welcome enquiries from researchers and collaborators working on UAV and satellite remote sensing, urban ecology, geohazards, climate and environmental planning.
  </p>

  <section class="section" aria-labelledby="email">
    <h2 class="section-title" id="email">Email</h2>
    {profile.emails.map((e) => (
      <p class="condensed" style="text-align:center"><Icon name="email" /> <a href={`mailto:${e}`}>{e}</a></p>
    ))}
    {profile.phone.show && <p class="condensed" style="text-align:center">Phone: {profile.phone.value}</p>}
    {profile.address.show && <p class="condensed" style="text-align:center">Address: {profile.address.value}</p>}
    <p class="condensed" style="text-align:center"><Icon name="location" /> <a href={profile.locationLink}>{profile.location}</a></p>
  </section>

  <section class="section" aria-labelledby="profiles">
    <h2 class="section-title" id="profiles">Academic Profiles</h2>
    <ul class="icons" style="justify-content:center;padding:0">
      {profiles.map((p) => (
        <li>
          <a class="icon-button" href={p.href} title={p.label} aria-label={p.label} rel="me noopener"><Icon name={p.icon} /></a>
        </li>
      ))}
    </ul>
    <p class="condensed" style="text-align:center">
      {profiles.map((p, i) => <>{i > 0 && ' · '}<a href={p.href}>{p.label}</a></>)}
    </p>
  </section>
</PageLayout>
