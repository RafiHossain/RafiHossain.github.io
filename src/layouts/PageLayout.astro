---
// Inner pages: centred title with an icon and a dashed rule.
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';

interface Props {
  title: string;
  icon: IconName;
  description?: string;
}
const { title, icon, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <h1 class="page-title"><Icon name={icon} />{title}</h1>
  <slot />
</BaseLayout>
